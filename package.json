{
  "name": "dsh-restart-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Input-bar restart button for DeepSeek Harness Web: one click (with confirm) restarts the dsh web process; the page auto-reconnects afterwards.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./typert": "./lib/contracts.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "slots"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT"
}
